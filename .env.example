# ============================================================
# FreeFrame — Environment Configuration
# ============================================================
#
# Development:
#   cp .env.example .env
#   docker compose -f docker-compose.dev.yml up --build
#   (Dev compose overrides most values below with local defaults)
#
# Production:
#   cp .env.example .env.prod
#   Edit .env.prod with your real credentials
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# ============================================================

# ─── Database ───────────────────────────────────────────────
# Dev: auto-overridden by docker-compose.dev.yml (local Postgres)
# Prod: set a strong password or use an external database
POSTGRES_USER=freeframe
POSTGRES_PASSWORD=freeframe
POSTGRES_DB=freeframe
DATABASE_URL=postgresql://freeframe:freeframe@localhost:5432/freeframe

# External database (RDS, Supabase, Neon, etc.):
# Remove the postgres service from compose, then set:
# DATABASE_URL=postgresql://user:password@your-db-host:5432/freeframe

# ─── Redis / Valkey ─────────────────────────────────────────
# Dev: no password needed (auto-overridden by dev compose)
# Prod: set a password or use an external Redis/Valkey instance
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# External Redis/Valkey (Upstash, ElastiCache, etc.):
# Remove the redis service from compose, then set:
# REDIS_URL=redis://:password@your-redis-host:6379/0

# ─── S3 Storage ─────────────────────────────────────────────
# Dev: "minio" uses the local MinIO container
# Prod: "s3" for any S3-compatible provider (AWS, R2, B2, Spaces, etc.)
S3_STORAGE=minio
S3_BUCKET=freeframe
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=          # Only if presigned URLs need a different base URL

# Production S3 example (uncomment and fill in):
# S3_STORAGE=s3
# S3_BUCKET=your-freeframe-bucket
# S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
# S3_SECRET_KEY=YOUR_S3_SECRET_KEY
# S3_REGION=us-east-1
# S3_ENDPOINT=                 # Set for non-AWS (e.g., https://acct.r2.cloudflarestorage.com)

# ─── Auth ───────────────────────────────────────────────────
# Prod: generate a strong secret →  openssl rand -hex 64
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login throttling (§233). Two buckets on POST /auth/login.
#
# Per ACCOUNT — the normalised email from the request body, hashed before it
# becomes a Redis key. This is the real limit; it cannot be spoofed by a
# header and one account being attacked never locks another one out. Every
# attempt counts, successes included.
LOGIN_RATE_LIMIT_PER_EMAIL=10
LOGIN_RATE_LIMIT_EMAIL_WINDOW_SECONDS=600
#
# Per IP — a coarse second brake, and only as trustworthy as whatever your
# reverse proxy puts in X-Real-Ip. Behind a tunnel or a shared NAT this can
# be one address for every user, so keep it generous; raise it rather than
# lower it if real traffic trips it.
LOGIN_RATE_LIMIT_PER_IP=60
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=600

# ─── Frontend ───────────────────────────────────────────────
# Dev: http://localhost:3000
# Prod: your actual domain with https://
FRONTEND_URL=http://localhost:3000

# ─── Email ──────────────────────────────────────────────────
# Option 1: SMTP (Mailgun, Postmark, SendGrid, self-hosted, etc.)
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=FreeFrame
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Option 2: AWS SES
# MAIL_PROVIDER=ses
# MAIL_FROM_ADDRESS=noreply@your-domain.com
# MAIL_FROM_NAME=FreeFrame
# AWS_MAIL_ACCESS_KEY_ID=YOUR_SES_ACCESS_KEY
# AWS_MAIL_SECRET_ACCESS_KEY=YOUR_SES_SECRET_KEY
# AWS_MAIL_REGION=us-east-1

# ─── SSL (Production only) ──────────────────────────────────
# Set DOMAIN and ACME_EMAIL to enable automatic Let's Encrypt SSL.
# Without these, FreeFrame runs on HTTP only (port 80).
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

# ─── Workers & Performance ──────────────────────────────────
API_WORKERS=4                  # Gunicorn worker processes (prod only)
TRANSCODING_CONCURRENCY=2     # Parallel video transcoding jobs (CPU intensive)
EMAIL_CONCURRENCY=2            # Parallel email sending jobs
TRANSCODER_ENGINE=ffmpeg

# ─── Stuck-processing recovery (§114, §219) ──────────────────
# Two thresholds, for two different states that both read as `processing`.
#
# STUCK_PROCESSING_MINUTES applies once a worker has actually STARTED the
# work (processing_started_at is set). It is a SILENCE threshold, not a
# duration limit: the progress callback touches the row on every new whole
# percent, so a legitimate multi-hour transcode keeps resetting the clock.
STUCK_PROCESSING_MINUTES=45
#
# STUCK_QUEUED_HOURS applies to a version that is `processing` but has
# never started -- queued, waiting for a free worker. Nothing touches such
# a row, so the minutes rule above cannot be applied to it at all without
# failing healthy files that are simply waiting their turn (which is what
# happened during a 641 GiB import). This is only the backstop for a task
# lost from the broker, so a week is deliberate: the point is that the row
# eventually stops claiming to be processing, not that it is reaped fast.
STUCK_QUEUED_HOURS=168

# ─── Celery broker (§219) ────────────────────────────────────────────
# How long Redis hides a delivered task before assuming the worker died
# and giving it to another one. Redis's own default is 3600, which with
# task_acks_late meant any transcode still running after an hour was
# restored to the queue and ENCODED A SECOND TIME alongside the first.
# Must stay above the longest legitimate task: one process_asset can run
# the HLS ladder (4 h ceiling) and then the download proxy (another 4 h)
# in sequence, plus a full-size download and upload.
CELERY_VISIBILITY_TIMEOUT_SECONDS=43200

# ─── Transcoder input URLs (§221) ────────────────────────────────────
# How long the presigned URL ffmpeg reads the original through stays
# valid. One transcode uses it for the probe, the HLS ladder (4 h
# ceiling) and the thumbnail that runs after the ladder has also been
# uploaded, so this must cover the whole sequence -- at 7200 two 95 GiB
# masters failed their thumbnail on an expired link after ~2.5 h of
# finished work. Keep it at or above the Celery visibility timeout
# above; SigV4 caps it at 604800 (7 days).
TRANSCODE_URL_EXPIRY_SECONDS=43200

# ─── Download links (§217) ───────────────────────────────────────────
# How long a link that hands out an ORIGINAL or a BATCH (zip) download
# stays valid. It replaced a hard-coded 24 h on originals and a 1 h link
# on the zip route — and an hour was shorter than the download it was
# meant to cover, so an interrupted multi-GB transfer could not be
# resumed at all once the token died.
#
# WHAT A LEAKED LINK EXPOSES, so the number is chosen knowingly: an
# ORIGINALS link is a prefix token, so it authorises every object under
# that asset-version's S3 folder (the original, the HLS ladder, the
# thumbnail, the persisted 1080p proxy) — one asset version, not the
# project. A STREAMED-ZIP link authorises one export id, and every
# request against it re-validates the share link (enabled, not expired,
# downloads still permitted, password session still valid) or the in-app
# creator's project membership, so revoking access kills it immediately
# whatever this is set to.
#
# Playback (thumbnails, HLS manifests and segments) is unaffected and
# keeps its own 24 h. So are graded-LUT export links, which stay at 1 h
# because the object itself is deleted after an hour.
DOWNLOAD_LINK_HOURS=72

# ─── CRC-32 of stored objects (§217) ─────────────────────────────────
# A streamed zip carries each entry's CRC-32 in its local header AND in
# the central directory, so the archive's byte layout — and any answer to
# a Range request — is undefined until every file's CRC is known. Each
# object is read once, 8 MiB at a time, and never again.
CRC_CHUNK_BYTES=8388608

# How many CRC reads may run at once across the whole fleet. ONE: these
# are routed to `transcoding`, which runs at concurrency 2 and is also
# the transcoder, so a Redis lease caps them here to keep one slot free
# for the HLS ladder. Must stay below TRANSCODING_CONCURRENCY.
CRC_MAX_CONCURRENT=1
# The lease is short and refreshed rather than long and trusted: a worker
# SIGKILLed mid-read (every deploy does this) must free the slot in
# minutes, not hours.
CRC_LEASE_SECONDS=300
CRC_LEASE_REFRESH_SECONDS=60
# Attempts before an object is left alone. A deleted or permanently
# unreadable file then marks its own entry skipped — exactly as the old
# build path skipped a member it could not read — instead of holding a
# whole selection at `preparing` forever.
CRC_MAX_ATTEMPTS=3

# The backfill for everything uploaded before §217. The MIGRATION DOES
# NOT BACKFILL: reading hundreds of GB inside one would be a deploy that
# appears to hang for hours. Start it once, by hand:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod \
#     -p freeframe exec worker \
#     celery -A apps.api.tasks.celery_app call backfill_object_crc32
#
# It takes one object per run and re-queues itself after the pause below,
# so one command drains the library at a rate the transcoder can live
# with. Set CRC_BACKFILL_ENABLED=false to stop it at the next hop.
CRC_BACKFILL_ENABLED=true
CRC_BACKFILL_OBJECTS_PER_RUN=1
CRC_BACKFILL_PAUSE_SECONDS=30

# ─── Streaming a zip through the API process (§217) ──────────────────
# A stalled client must not pin an upstream S3 read forever. IDLE bounds
# ONE 1 MiB read from the bucket (a LAN read taking two minutes is a dead
# connection, not a slow one). STALL bounds the gap between two chunks
# being TAKEN by the client; past it the upstream body is closed and the
# stream ends, and a client that is really still there resumes with a
# fresh Range at no cost.
ZIP_STREAM_IDLE_SECONDS=120
ZIP_STREAM_STALL_SECONDS=900
